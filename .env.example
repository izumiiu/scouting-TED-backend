NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:5174
TRUST_PROXY_HOPS=0
# URI credentials must have readWrite on the TED database below. Never use scouting_dev.
MONGODB_URI=
MONGODB_DB_NAME=ted_intake_dev
JWT_SECRET=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ENABLE_WORKER=true
# Spaces requests in this TED database; Groq quotas are also shared with other apps.
AI_REQUEST_INTERVAL_MS=65000
OFFICER_EMAIL=
OFFICER_PASSWORD=
OFFICER_NAME=เจ้าหน้าที่ TED
ORGANIZATION_ID=ted
