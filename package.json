{
  "name": "ted-intake-backend",
  "version": "0.1.0",
  "description": "TED document intake, qualitative analysis and officer review",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/server.js\"",
    "start": "node dist/server.js",
    "test": "npm run build && npm run check:tests && vitest run --pool=threads --maxWorkers=1",
    "create-officer": "node dist/scripts/create-officer.js",
    "check:tests": "tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "3.4.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "multer": "2.5.0",
    "pdfjs-dist": "5.4.296",
    "uuid": "^14.0.1",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "private": true
}
